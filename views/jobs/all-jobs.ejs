<%
  const hasActiveFilters = Boolean(query.q || query.location || query.category || query.skill || query.salary || (query.sort && query.sort !== 'recent'));
  
  function buildFilterUrl(overrides = {}) {
    const params = new URLSearchParams();
    const current = {
      q: query.q || '',
      location: query.location || '',
      category: query.category || '',
      skill: query.skill || '',
      salary: query.salary || '',
      sort: query.sort || 'recent'
    };
    const merged = { ...current, ...overrides };
    Object.entries(merged).forEach(([k, v]) => {
      if (v && (k !== 'sort' || v !== 'recent')) {
        params.set(k, v);
      }
    });
    const qs = params.toString();
    return qs ? `/jobs?${qs}` : '/jobs';
  }
%>

<div class="page-header" style="margin-bottom: 20px;">
  <div>
    <span class="eyebrow">Explore Opportunities</span>
    <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0 6px;">Find Your Next Role</h1>
    <p class="subtitle" style="margin: 0; color: var(--color-text-muted);">
      Browse <%= (facets && facets.totalJobs) ? facets.totalJobs : jobs.length %> open positions across top engineering, design, and business teams.
    </p>
  </div>
</div>

<!-- ── Main Search Bar ── -->
<form action="/jobs" method="GET" class="search-bar" style="margin-bottom: 16px;">
  <% if (query.category) { %><input type="hidden" name="category" value="<%= query.category %>" /><% } %>
  <% if (query.skill) { %><input type="hidden" name="skill" value="<%= query.skill %>" /><% } %>
  <% if (query.salary) { %><input type="hidden" name="salary" value="<%= query.salary %>" /><% } %>
  <% if (query.sort && query.sort !== 'recent') { %><input type="hidden" name="sort" value="<%= query.sort %>" /><% } %>

  <div class="search-field">
    <%- icon('search') %>
    <input type="text" name="q" placeholder="Job title, company, or keyword..." value="<%= query.q %>" />
  </div>
  <div class="search-field">
    <%- icon('map-pin') %>
    <input type="text" name="location" placeholder="City or 'Remote'..." value="<%= query.location %>" />
  </div>
  <button type="submit" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
    <%- icon('search') %> Search
  </button>
  <% if (hasActiveFilters) { %>
    <a href="/jobs" class="btn btn-ghost" title="Reset all filters">Clear</a>
  <% } %>
</form>

<!-- ── Top Trending Skills Quick Bar ── -->
<% if (facets && facets.topSkills && facets.topSkills.length > 0) { %>
  <div class="trending-skills-bar" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; font-size: 0.84rem;">
    <span style="color: var(--color-text-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
      <%- icon('sparkles') %> Trending:
    </span>
    <% facets.topSkills.slice(0, 7).forEach(function (sk) { %>
      <a href="<%= buildFilterUrl({ skill: query.skill === sk.name ? '' : sk.name }) %>"
         class="tag <%= query.skill === sk.name ? 'tag-active' : '' %>"
         style="cursor: pointer; text-decoration: none; <%= query.skill === sk.name ? 'background: var(--brand-600); color: #fff;' : '' %>">
        <%= sk.name %> (<%= sk.count %>)
      </a>
    <% }) %>
  </div>
<% } %>

<!-- ── Two-Column Layout: Sidebar Filters + Jobs Grid ── -->
<div class="jobs-layout-grid" style="display: grid; grid-template-columns: 280px 1fr; gap: 24px; align-items: start;">
  
  <!-- ── Left Column: Facet Filters Sidebar ── -->
  <aside class="jobs-filter-sidebar" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; position: sticky; top: 80px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border);">
      <h2 style="font-size: 1.05rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 6px;">
        <%- icon('filter') %> Filters
      </h2>
      <% if (hasActiveFilters) { %>
        <a href="/jobs" style="font-size: 0.82rem; color: var(--brand-600); font-weight: 600; text-decoration: none;">Reset all</a>
      <% } %>
    </div>

    <!-- Active Filters Summary Chips -->
    <% if (hasActiveFilters) { %>
      <div style="margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 6px;">
        <% if (query.q) { %>
          <a href="<%= buildFilterUrl({ q: '' }) %>" class="tag" style="background: var(--brand-50); color: var(--brand-700); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Remove keyword filter">
            Keyword: <%= query.q %> <%- icon('x') %>
          </a>
        <% } %>
        <% if (query.location) { %>
          <a href="<%= buildFilterUrl({ location: '' }) %>" class="tag" style="background: var(--brand-50); color: var(--brand-700); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Remove location filter">
            Loc: <%= query.location %> <%- icon('x') %>
          </a>
        <% } %>
        <% if (query.category) { %>
          <a href="<%= buildFilterUrl({ category: '' }) %>" class="tag" style="background: var(--brand-50); color: var(--brand-700); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Remove category filter">
            <%= query.category %> <%- icon('x') %>
          </a>
        <% } %>
        <% if (query.skill) { %>
          <a href="<%= buildFilterUrl({ skill: '' }) %>" class="tag" style="background: var(--brand-50); color: var(--brand-700); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Remove skill filter">
            <%= query.skill %> <%- icon('x') %>
          </a>
        <% } %>
        <% if (query.salary) { %>
          <a href="<%= buildFilterUrl({ salary: '' }) %>" class="tag" style="background: var(--brand-50); color: var(--brand-700); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Remove salary filter">
            Salary: <%= query.salary %> <%- icon('x') %>
          </a>
        <% } %>
      </div>
    <% } %>

    <!-- Filter Section: Categories -->
    <% if (facets && facets.categories && facets.categories.length > 0) { %>
      <div class="filter-group" style="margin-bottom: 20px;">
        <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--color-text); margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.04em;">Category</h3>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <a href="<%= buildFilterUrl({ category: '' }) %>" 
             style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; text-decoration: none; padding: 4px 8px; border-radius: 6px; color: <%= !query.category ? 'var(--brand-600); font-weight: 700; background: var(--brand-50);' : 'var(--color-text-muted);' %>">
            <span>All Categories</span>
            <span style="font-size: 0.78rem; opacity: 0.8;"><%= facets.totalJobs %></span>
          </a>
          <% facets.categories.forEach(function (cat) { %>
            <a href="<%= buildFilterUrl({ category: query.category === cat.name ? '' : cat.name }) %>"
               style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; text-decoration: none; padding: 4px 8px; border-radius: 6px; color: <%= query.category === cat.name ? 'var(--brand-600); font-weight: 700; background: var(--brand-50);' : 'var(--color-text-muted);' %>">
              <span><%= cat.name %></span>
              <span style="font-size: 0.78rem; opacity: 0.8;"><%= cat.count %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Filter Section: Top Locations -->
    <% if (facets && facets.locations && facets.locations.length > 0) { %>
      <div class="filter-group" style="margin-bottom: 20px; border-top: 1px solid var(--color-border); padding-top: 16px;">
        <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--color-text); margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.04em;">Location</h3>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <% facets.locations.slice(0, 6).forEach(function (loc) { %>
            <a href="<%= buildFilterUrl({ location: query.location === loc.name ? '' : loc.name }) %>"
               style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; text-decoration: none; padding: 4px 8px; border-radius: 6px; color: <%= query.location === loc.name ? 'var(--brand-600); font-weight: 700; background: var(--brand-50);' : 'var(--color-text-muted);' %>">
              <span><%= loc.name %></span>
              <span style="font-size: 0.78rem; opacity: 0.8;"><%= loc.count %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Filter Section: Salary Range -->
    <div class="filter-group" style="margin-bottom: 20px; border-top: 1px solid var(--color-border); padding-top: 16px;">
      <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--color-text); margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.04em;">Salary (LPA)</h3>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <% const salaryOpts = [
          { label: 'Any Salary', val: '' },
          { label: 'Under ₹6 LPA', val: '0-6' },
          { label: '₹6 - ₹12 LPA', val: '6-12' },
          { label: '₹12 - ₹20 LPA', val: '12-20' },
          { label: '₹20+ LPA', val: '20+' }
        ]; %>
        <% salaryOpts.forEach(function (s) { %>
          <a href="<%= buildFilterUrl({ salary: query.salary === s.val ? '' : s.val }) %>"
             style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; text-decoration: none; padding: 4px 8px; border-radius: 6px; color: <%= query.salary === s.val || (!query.salary && !s.val) ? 'var(--brand-600); font-weight: 700; background: var(--brand-50);' : 'var(--color-text-muted);' %>">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= (query.salary === s.val || (!query.salary && !s.val)) ? 'var(--brand-600)' : 'var(--color-border)' %>;"></span>
            <span><%= s.label %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </aside>

  <!-- ── Right Column: Search Results & Jobs Grid ── -->
  <section class="jobs-results-column">
    <!-- Results Header & Sort Control -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
      <div style="font-size: 0.95rem; font-weight: 600; color: var(--color-text);">
        Showing <span style="color: var(--brand-600); font-weight: 700;"><%= jobs.length %></span> job<%= jobs.length === 1 ? '' : 's' %>
        <% if (query.q) { %> for "<%= query.q %>"<% } %>
      </div>

      <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
        <span style="color: var(--color-text-muted);"><%- icon('sliders') %> Sort by:</span>
        <select onchange="window.location.href = this.value;" style="padding: 6px 12px; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-bg-surface); color: var(--color-text); font-size: 0.88rem; font-family: inherit; cursor: pointer;">
          <option value="<%= buildFilterUrl({ sort: 'recent' }) %>" <%= !query.sort || query.sort === 'recent' ? 'selected' : '' %>>Latest Posted</option>
          <option value="<%= buildFilterUrl({ sort: 'openings' }) %>" <%= query.sort === 'openings' ? 'selected' : '' %>>Most Openings</option>
          <option value="<%= buildFilterUrl({ sort: 'deadline' }) %>" <%= query.sort === 'deadline' ? 'selected' : '' %>>Expiring Soon</option>
          <option value="<%= buildFilterUrl({ sort: 'oldest' }) %>" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
        </select>
      </div>
    </div>

    <!-- Empty State -->
    <% if (jobs.length === 0) { %>
      <div class="empty-state" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 48px 24px; text-align: center;">
        <%- icon('inbox', 'icon-xl') %>
        <h3 style="margin: 14px 0 6px; font-size: 1.25rem;">No matching jobs found</h3>
        <p style="color: var(--color-text-muted); margin: 0 0 20px;">Try adjusting your search criteria, clearing filters, or browsing all categories.</p>
        <a href="/jobs" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
          <%- icon('search') %> View All Jobs
        </a>
      </div>
    <% } else { %>
      <!-- Jobs Grid -->
      <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
        <% jobs.forEach(function (job) { %>
          <% const isSaved = typeof savedJobIds !== 'undefined' && Array.isArray(savedJobIds) && savedJobIds.includes(job.id); %>
          <div class="card" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="card-top" style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px;">
                <span class="avatar" style="width: 44px; height: 44px; font-size: 1.1rem; background: <%= colorForName(job.companyname) %>">
                  <%= job.companyname.charAt(0).toUpperCase() %>
                </span>
                <div class="card-heading" style="flex: 1; min-width: 0;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                    <h3 style="margin: 0 0 4px; font-weight: 700; font-size: 1.1rem; line-height: 1.3;">
                      <a href="/jobs/<%= job.id %>" style="color: var(--color-text); text-decoration: none;">
                        <%= job.jobdesignation %>
                      </a>
                    </h3>
                    <% if (job.skillMatch) { %>
                      <span style="flex-shrink: 0; font-size: 0.74rem; font-weight: 800; padding: 2px 8px; border-radius: 999px; background: <%= job.skillMatch.tierColor %>22; color: <%= job.skillMatch.tierColor %>; border: 1px solid <%= job.skillMatch.tierColor %>66; white-space: nowrap;">
                        🎯 <%= job.skillMatch.tierLabel %>
                      </span>
                    <% } %>
                  </div>
                  <p class="company" style="margin: 0; color: var(--color-text-muted); font-size: 0.88rem; display: flex; align-items: center; gap: 4px;">
                    <%- icon('building') %>
                    <%= job.companyname %> &middot; <%- icon('map-pin') %> <%= job.joblocation %>
                  </p>
                </div>
              </div>

              <div class="meta" style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 0.86rem; color: var(--color-text-muted);">
                <span style="font-weight: 600; color: var(--brand-600);"><%- icon('dollar-sign') %> <%= job.salary %></span>
                <span><%- icon('users') %> <%= job.openings %> opening<%= job.openings === 1 ? '' : 's' %></span>
                <% if (job.jobcategory) { %>
                  <span><%- icon('briefcase') %> <%= job.jobcategory %></span>
                <% } %>
              </div>

              <div class="tags" style="margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 6px;">
                <% job.skillrequired.slice(0, 4).forEach(function (skill) { %>
                  <a href="<%= buildFilterUrl({ skill: query.skill === skill ? '' : skill }) %>" 
                     class="tag <%= query.skill === skill ? 'tag-active' : '' %>"
                     style="text-decoration: none; cursor: pointer; <%= query.skill === skill ? 'background: var(--brand-600); color: #fff;' : '' %>">
                    <%= skill %>
                  </a>
                <% }) %>
              </div>
            </div>

            <div>
              <div class="card-actions" style="display: flex; gap: 8px; align-items: center; border-top: 1px solid var(--color-border); padding-top: 12px; margin-top: 8px;">
                <a href="/jobs/<%= job.id %>" class="btn btn-secondary btn-sm" style="flex: 1; text-align: center;">View details</a>
                
                <% if (user && String(user.role || '').toUpperCase() === 'APPLICANT') { %>
                  <% if (isSaved) { %>
                    <form action="/applicant/saved/<%= job.id %>/remove" method="POST" class="inline-form" style="margin:0;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-ghost btn-sm" title="Remove from saved jobs" style="color: var(--brand-600); background: var(--brand-50); border: 1px solid var(--brand-200); display: inline-flex; align-items: center; gap: 4px;">
                        <%- icon('bookmark-filled') %>
                        <span>Saved</span>
                      </button>
                    </form>
                  <% } else { %>
                    <form action="/applicant/saved/<%= job.id %>" method="POST" class="inline-form" style="margin:0;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-ghost btn-sm" title="Bookmark job" style="border: 1px solid var(--color-border); display: inline-flex; align-items: center; gap: 4px;">
                        <%- icon('bookmark') %>
                        <span>Save</span>
                      </button>
                    </form>
                  <% } %>
                <% } else if (!user) { %>
                  <a href="/login" class="btn btn-ghost btn-sm" title="Sign in to save job" style="border: 1px solid var(--color-border); display: inline-flex; align-items: center; gap: 4px;">
                    <%- icon('bookmark') %>
                    <span>Save</span>
                  </a>
                <% } %>
              </div>
              <p class="hint" style="margin: 8px 0 0; font-size: 0.78rem; color: var(--color-text-muted);">
                Posted <%= timeAgo(job.jobposted) %>
                <% if (job.applyby) { %>
                  &middot; <%= daysUntil(job.applyby) >= 0 ? daysUntil(job.applyby) + 'd left to apply' : 'Closed' %>
                <% } %>
              </p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<style>
  @media (max-width: 880px) {
    .jobs-layout-grid {
      grid-template-columns: 1fr !important;
    }
    .jobs-filter-sidebar {
      position: static !important;
    }
  }
</style>
