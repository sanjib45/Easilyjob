<div class="page-header">
  <div>
    <span class="eyebrow">Job board</span>
    <h1>Browse jobs</h1>
    <p class="subtitle"><%= jobs.length %> open role<%= jobs.length === 1 ? "" : "s" %> right now.</p>
  </div>
</div>

<form action="/jobs" method="GET" class="search-bar">
  <div class="search-field">
    <%- icon('search') %>
    <input type="text" name="q" placeholder="Search title, company, skill..." value="<%= query.q %>" />
  </div>
  <div class="search-field">
    <%- icon('map-pin') %>
    <input type="text" name="location" placeholder="Location" value="<%= query.location %>" />
  </div>
  <button type="submit" class="btn btn-primary">Search</button>
  <% if (query.q || query.location) { %>
    <a href="/jobs" class="btn btn-ghost">Clear</a>
  <% } %>
</form>

<% if (jobs.length === 0) { %>
  <div class="empty-state">
    <%- icon('inbox', 'icon-xl') %>
    <h3>No jobs match your search</h3>
    <p>Try a different keyword or clear your filters.</p>
    <a href="/jobs" class="btn btn-secondary btn-sm">Clear filters</a>
  </div>
<% } else { %>
  <div class="grid">
    <% jobs.forEach(function (job) { %>
      <div class="card">
        <div class="card-top">
          <span class="avatar" style="background: <%= colorForName(job.companyname) %>"><%= job.companyname.charAt(0).toUpperCase() %></span>
          <div class="card-heading">
            <h3><a href="/jobs/<%= job.id %>"><%= job.jobdesignation %></a></h3>
            <p class="company">
              <%- icon('building') %>
              <%= job.companyname %> &middot; <%= job.joblocation %>
            </p>
          </div>
        </div>

        <div class="meta">
          <span><%- icon('dollar-sign') %> <%= job.salary %></span>
          <span><%- icon('users') %> <%= job.openings %> opening<%= job.openings === 1 ? "" : "s" %></span>
        </div>

        <div class="tags">
          <% job.skillrequired.slice(0, 4).forEach(function (skill) { %>
            <span class="tag"><%= skill %></span>
          <% }) %>
        </div>

        <div class="card-actions">
          <a href="/jobs/<%= job.id %>" class="btn btn-secondary btn-sm" style="flex:1;">View details</a>
        </div>
        <p class="hint" style="margin-top: -4px;">Posted <%= timeAgo(job.jobposted) %></p>
      </div>
    <% }) %>
  </div>
<% } %>
