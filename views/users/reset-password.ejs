<div class="form-card">
  <span class="avatar" style="margin: 0 auto 14px; background: linear-gradient(135deg, var(--brand-600), #0f172a);">
    <%- icon('lock', 'icon-lg') %>
  </span>
  <h1>Reset Password</h1>
  <p class="subtitle">Enter your new password below.</p>

  <form action="/reset-password" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="token" value="<%= token %>" />

    <div class="form-group">
      <label for="password"><%- icon('lock') %> New Password</label>
      <div class="password-wrapper" style="position: relative;">
        <input type="password" id="password" name="password" minlength="8" required style="padding-right: 2.5rem; width: 100%; box-sizing: border-box;" autofocus />
        <button type="button" class="password-toggle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0; display: flex; align-items: center; justify-content: center;" onclick="togglePassword('password', this)">
          <%- icon('eye') %>
        </button>
      </div>
      <p class="hint">At least 8 characters.</p>
    </div>

    <script>
      function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
          input.type = 'text';
          btn.innerHTML = '<%- icon("eye-off") %>';
        } else {
          input.type = 'password';
          btn.innerHTML = '<%- icon("eye") %>';
        }
      }
    </script>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Reset Password</button>
  </form>
</div>
