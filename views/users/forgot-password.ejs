<div class="form-card">
  <span class="avatar" style="margin: 0 auto 14px; background: linear-gradient(135deg, var(--brand-600), #0f172a);">
    <%- icon('lock', 'icon-lg') %>
  </span>
  <h1>Forgot Password</h1>
  <p class="subtitle">Enter your email and we'll send you a reset link.</p>

  <form action="/forgot-password" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group">
      <label for="email"><%- icon('mail') %> Email</label>
      <input type="email" id="email" name="email" required autofocus />
    </div>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Send Reset Link</button>
  </form>
  <p class="form-footer">Remember your password? <a href="/login">Log in</a></p>
</div>
