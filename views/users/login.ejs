<div class="form-card">
  <span class="avatar" style="margin: 0 auto 14px; background: linear-gradient(135deg, var(--brand-600), #0f172a);">
    <%- icon('lock', 'icon-lg') %>
  </span>
  <h1>Welcome back</h1>
  <p class="subtitle">Log in to continue to Easily Jobs.</p>

  <form action="/login" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group">
      <label for="email"><%- icon('mail') %> Email</label>
      <input type="email" id="email" name="email" required autofocus />
    </div>

    <div class="form-group">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <label for="password" style="margin-bottom: 0;"><%- icon('lock') %> Password</label>
        <a href="/forgot-password" style="font-size: 0.875rem; color: var(--brand-500); text-decoration: none;">Forgot password?</a>
      </div>
      <div class="password-wrapper" style="position: relative;">
        <input type="password" id="password" name="password" required style="padding-right: 2.5rem; width: 100%; box-sizing: border-box;" />
        <button type="button" class="password-toggle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0; display: flex; align-items: center; justify-content: center;" onclick="togglePassword('password', this)">
          <%- icon('eye') %>
        </button>
      </div>
    </div>

    <script>
      function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
          input.type = 'text';
          btn.innerHTML = '<%- icon("eye-off") %>';
        } else {
          input.type = 'password';
          btn.innerHTML = '<%- icon("eye") %>';
        }
      }
    </script>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Log in</button>
  </form>
  <p class="form-footer">Don't have an account? <a href="/register">Sign up</a></p>
</div>
