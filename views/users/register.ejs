<div class="form-card">
  <span class="avatar" style="margin: 0 auto 14px; background: linear-gradient(135deg, var(--brand-600), #0f172a);">
    <%- icon('user', 'icon-lg') %>
  </span>
  <h1>Create your account</h1>
  <p class="subtitle">Join Easily Jobs as an applicant or a recruiter.</p>

  <div style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.1), rgba(245, 158, 11, 0.1)); border: 1px solid var(--brand-500); border-radius: 12px; padding: 12px 16px; margin: 16px 0 20px; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
    <div style="display: flex; align-items: center; gap: 10px; font-size: 0.88rem;">
      <span style="font-size: 1.4rem;">🤖</span>
      <span style="color: var(--color-text); font-weight: 500;">
        Looking for a faster way? Try our <strong>1-Minute Quick Apply Bot</strong>!
      </span>
    </div>
    <a href="/quick-apply" class="btn btn-primary btn-sm" style="white-space: nowrap;">
      Try Bot →
    </a>
  </div>

  <form action="/register" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group">
      <label>I am a...</label>
      <div class="radio-group">
        <label class="radio-card">
          <input type="radio" name="role" value="applicant" checked />
          <span class="radio-icon"><%- icon('search') %></span>
          <span class="radio-label">Job seeker</span>
        </label>
        <label class="radio-card">
          <input type="radio" name="role" value="recruiter" />
          <span class="radio-icon"><%- icon('briefcase') %></span>
          <span class="radio-label">Recruiter</span>
        </label>
      </div>
    </div>

    <div class="form-group">
      <label for="name"><%- icon('user') %> Full name</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div class="form-group">
      <label for="email"><%- icon('mail') %> Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div class="form-group">
      <label for="password"><%- icon('lock') %> Password</label>
      <div class="password-wrapper" style="position: relative;">
        <input type="password" id="password" name="password" minlength="8" required style="padding-right: 2.5rem; width: 100%; box-sizing: border-box;" />
        <button type="button" class="password-toggle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0; display: flex; align-items: center; justify-content: center;" onclick="togglePassword('password', this)">
          <%- icon('eye') %>
        </button>
      </div>
      <p class="hint">At least 8 characters.</p>
    </div>

    <script>
      function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
          input.type = 'text';
          btn.innerHTML = '<%- icon("eye-off") %>';
        } else {
          input.type = 'password';
          btn.innerHTML = '<%- icon("eye") %>';
        }
      }
    </script>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Create account</button>
  </form>
  <p class="form-footer">Already have an account? <a href="/login">Log in</a></p>
</div>
