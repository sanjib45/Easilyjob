<div class="confirm-modal-backdrop" id="confirmModalBackdrop" style="display: none;" aria-hidden="true">
  <div class="confirm-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle" aria-describedby="confirmModalMessage" tabindex="-1">
    <div class="confirm-modal-header">
      <div class="confirm-modal-icon-badge" id="confirmModalIcon">
        <%- icon('alert-triangle') %>
      </div>
      <div>
        <h3 class="confirm-modal-title" id="confirmModalTitle">Confirm Action</h3>
        <p class="confirm-modal-subtitle" id="confirmModalMessage">Are you sure you want to proceed?</p>
      </div>
    </div>
    <div class="confirm-modal-actions">
      <button type="button" class="btn btn-secondary" id="confirmModalCancelBtn">Cancel</button>
      <button type="button" class="btn btn-danger" id="confirmModalConfirmBtn">Proceed</button>
    </div>
  </div>
</div>
