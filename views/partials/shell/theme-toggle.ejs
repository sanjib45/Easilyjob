<div class="theme-select-container">
  <label for="themeModeSelect" class="theme-select-label" id="themeSelectLabel">
    <%- icon('sun') %> <span>Theme</span>
  </label>
  <div class="theme-button-group" role="group" aria-labelledby="themeSelectLabel">
    <button type="button" class="theme-btn" data-theme-val="light" aria-pressed="false" title="Light Theme" aria-label="Light Theme">
      <%- icon('sun') %>
    </button>
    <button type="button" class="theme-btn" data-theme-val="dark" aria-pressed="false" title="Dark Theme" aria-label="Dark Theme">
      <%- icon('moon') %>
    </button>
    <button type="button" class="theme-btn" data-theme-val="system" aria-pressed="false" title="System Theme" aria-label="System Theme">
      <%- icon('layers') %>
    </button>
  </div>
</div>
