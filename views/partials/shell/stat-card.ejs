<div class="stat-card" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; display: flex; align-items: center; gap: 16px;">
  <div class="stat-icon" style="width: 46px; height: 46px; border-radius: 12px; background: rgba(13, 148, 136, 0.12); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
    <%- icon(statIcon || 'layers') %>
  </div>
  <div>
    <div class="stat-value" style="font-size: 1.5rem; font-weight: 800; line-height: 1.1;"><%= statValue %></div>
    <div class="stat-label" style="font-size: 0.82rem; color: var(--color-text-muted); margin-top: 2px;"><%= statLabel %></div>
  </div>
</div>
