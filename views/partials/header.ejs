<header class="site-header" id="siteHeader">
  <div class="header-inner container">
    <a href="/" class="brand" aria-label="Easily Jobs Home">
      <span class="brand-mark">EJ</span>
      <span class="brand-name">Easily<span class="brand-accent-text">Jobs</span></span>
    </a>

    <nav class="nav-center" id="siteNav" aria-label="Main Navigation">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">
        <span class="nav-link-text">Home</span>
      </a>
      <a href="/jobs" class="nav-link <%= currentPath === '/jobs' ? 'active' : '' %>">
        <span class="nav-link-text">Jobs</span>
        <span class="nav-chevron"><%- icon('chevron-down') %></span>
      </a>
      <% if (user && String(user.role || "").toUpperCase() === "RECRUITER") { %>
        <a href="/recruiter" class="nav-link <%= currentPath === '/recruiter' ? 'active' : '' %>">
          <span class="nav-link-text">ATS Hub</span>
          <span class="nav-chevron"><%- icon('chevron-down') %></span>
        </a>
        <a href="/recruiter/applicants" class="nav-link <%= currentPath.startsWith('/recruiter/applicants') ? 'active' : '' %>">
          <span class="nav-link-text">Pipeline</span>
        </a>
        <a href="/recruiter/interviews" class="nav-link <%= currentPath.startsWith('/recruiter/interviews') ? 'active' : '' %>">
          <span class="nav-link-text">Interviews</span>
        </a>
        <a href="/jobs/new" class="nav-link nav-link-highlight <%= currentPath === '/jobs/new' ? 'active' : '' %>">
          <span class="nav-link-icon"><%- icon('plus') %></span>
          <span class="nav-link-text">Post Job</span>
        </a>
      <% } else if (user) { %>
        <a href="/applicant/applications" class="nav-link <%= currentPath.startsWith('/applicant/applications') ? 'active' : '' %>">
          <span class="nav-link-text">Applications</span>
          <span class="nav-chevron"><%- icon('chevron-down') %></span>
        </a>
        <a href="/applicant/saved" class="nav-link <%= currentPath.startsWith('/applicant/saved') ? 'active' : '' %>">
          <span class="nav-link-text">Saved Jobs</span>
        </a>
        <a href="/applicant" class="nav-link <%= currentPath === '/applicant' || currentPath === '/applicant/dashboard' ? 'active' : '' %>">
          <span class="nav-link-text">Dashboard</span>
        </a>
      <% } else { %>
        <a href="/quick-apply" class="nav-link <%= currentPath === '/quick-apply' ? 'active' : '' %>">
          <span class="nav-link-icon"><%- icon('zap') %></span>
          <span class="nav-link-text">Quick Apply</span>
        </a>
      <% } %>
    </nav>

    <div class="nav-right-cluster">
      <% if (user) { %>
        <div class="user-capsule-btn">
          <span class="user-capsule-avatar" style="background: <%= colorForName(user.name) %>"><%= initialsFor(user.name) %></span>
          <span class="user-capsule-name"><%= user.name %></span>
          <% if (String(user.role || "").toUpperCase() === "RECRUITER") { %>
            <span class="role-badge">Recruiter</span>
          <% } %>
          <form action="/logout" method="POST" class="inline-form logout-form"
            data-confirm="Are you sure you want to log out of your session?"
            data-confirm-title="Log Out Confirmation"
            data-confirm-message="You are about to log out of your Easily Jobs account. Would you like to proceed?"
            data-confirm-action="Log Out"
            data-confirm-variant="danger"
            data-confirm-icon="log-out">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="user-capsule-logout-btn" title="Log out of account" aria-label="Log out of account">
              <%- icon('log-out') %>
            </button>
          </form>
        </div>
      <% } else { %>
        <a href="/login" class="nav-link nav-auth-link">Log in</a>
        <a href="/register" class="btn btn-primary btn-sm nav-signup-btn">Sign up</a>
      <% } %>

      <!-- Signature Dual-Mode Capsule Pill Theme Switcher -->
      <div class="theme-pill-switcher" id="topbarThemeBtn" role="button" tabindex="0" title="Toggle Light / Dark theme" aria-label="Toggle Light / Dark theme">
        <span class="theme-pill-item pill-sun"><%- icon('sun') %></span>
        <span class="theme-pill-item pill-moon"><%- icon('moon') %></span>
      </div>

      <a href="/jobs" class="grid-launcher-btn" title="All Workspaces & Roles" aria-label="All Workspaces">
        <%- icon('grid') %>
      </a>

      <!-- Mobile Navigation Hamburger Toggle -->
      <button type="button" class="header-mobile-toggle" id="headerMobileToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="siteNav">
        <span class="hamburger-bar hamburger-bar-1"></span>
        <span class="hamburger-bar hamburger-bar-2"></span>
        <span class="hamburger-bar hamburger-bar-3"></span>
      </button>
    </div>
  </div>
  
  <!-- Mobile Navigation Backdrop -->
  <div class="header-nav-backdrop" id="headerNavBackdrop"></div>
</header>
