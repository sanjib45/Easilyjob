<div class="page-header" style="margin-bottom: 24px;">
  <div>
    <span class="eyebrow">Candidate Portal</span>
    <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0 6px;">Saved Jobs</h1>
    <p class="subtitle" style="margin: 0; color: var(--color-text-muted);">
      <%= savedJobs ? savedJobs.length : 0 %> bookmarked role<%= (savedJobs && savedJobs.length === 1) ? '' : 's' %> saved for quick review and application.
    </p>
  </div>
  <div>
    <a href="/jobs" class="btn btn-secondary btn-sm" style="display:inline-flex; align-items:center; gap:6px;">
      <%- icon('search') %> Explore more jobs
    </a>
  </div>
</div>

<% if (!savedJobs || savedJobs.length === 0) { %>
  <%- include('../partials/shell/empty-state', {
    emptyIcon: 'bookmark',
    emptyTitle: 'No saved jobs yet',
    emptySubtitle: 'While browsing open positions, tap the Save button on any job card to bookmark it for later.'
  }) %>
<% } else { %>
  <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px;">
    <% savedJobs.forEach(function (item) { %>
      <% 
        let skillsList = [];
        try {
          skillsList = JSON.parse(item.job.skills || '[]');
        } catch(e) {
          skillsList = typeof item.job.skills === 'string' ? item.job.skills.split(',').map(s=>s.trim()).filter(Boolean) : [];
        }
        const isClosed = item.job.status !== 'OPEN' || (item.job.applyBy && daysUntil(item.job.applyBy) < 0);
      %>
      <div class="card" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        <div>
          <div class="card-top" style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px;">
            <span class="avatar" style="width: 44px; height: 44px; font-size: 1.1rem; background: <%= colorForName(item.job.companyName) %>">
              <%= item.job.companyName.charAt(0).toUpperCase() %>
            </span>
            <div class="card-heading" style="flex: 1; min-width: 0;">
              <h3 style="margin: 0 0 4px; font-weight: 700; font-size: 1.1rem; line-height: 1.3;">
                <a href="/jobs/<%= item.job.id %>" style="color: var(--color-text); text-decoration: none;">
                  <%= item.job.designation %>
                </a>
              </h3>
              <p class="company" style="margin: 0; color: var(--color-text-muted); font-size: 0.88rem; display: flex; align-items: center; gap: 4px;">
                <%- icon('building') %>
                <%= item.job.companyName %> &middot; <%- icon('map-pin') %> <%= item.job.location %>
              </p>
            </div>
          </div>

          <div class="meta" style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 0.86rem; color: var(--color-text-muted);">
            <span style="font-weight: 600; color: var(--brand-600);"><%- icon('dollar-sign') %> <%= item.job.salary %></span>
            <% if (item.job.category) { %>
              <span><%- icon('briefcase') %> <%= item.job.category %></span>
            <% } %>
            <% if (item.job.applyBy) { %>
              <span>
                <%- icon('calendar') %>
                <% if (daysUntil(item.job.applyBy) >= 0) { %>
                  <%= daysUntil(item.job.applyBy) %>d left
                <% } else { %>
                  <span style="color: var(--danger-500); font-weight:600;">Closed</span>
                <% } %>
              </span>
            <% } %>
          </div>

          <% if (skillsList && skillsList.length > 0) { %>
            <div class="tags" style="margin-bottom: 16px;">
              <% skillsList.slice(0, 4).forEach(function (skill) { %>
                <span class="tag"><%= skill %></span>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 14px;">
          <a href="/jobs/<%= item.job.id %>" class="btn btn-primary btn-sm" style="flex: 1; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
            <% if (isClosed) { %>
              View details
            <% } else { %>
              <%- icon('arrow-right') %> View & Apply
            <% } %>
          </a>
          <form action="/applicant/saved/<%= item.job.id %>/remove" method="POST" data-confirm data-confirm-title="Remove Saved Job" data-confirm-message="Remove '<%= item.job.designation %>' from your saved jobs?" data-confirm-action="Remove" data-confirm-variant="danger" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm" title="Remove bookmark" style="color: var(--color-text-muted); border: 1px solid var(--color-border);">
              <%- icon('trash') %>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
