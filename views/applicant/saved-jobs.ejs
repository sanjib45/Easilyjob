<div class="page-header" style="margin-bottom: 24px;">
  <div>
    <span class="eyebrow">Candidate Portal</span>
    <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0 6px;">Saved Jobs</h1>
    <p class="subtitle" style="margin: 0; color: var(--color-text-muted);">Bookmarked roles you want to review or apply to later.</p>
  </div>
</div>

<% if (!savedJobs || savedJobs.length === 0) { %>
  <%- include('../partials/shell/empty-state', { emptyIcon: 'bookmark', emptyTitle: 'No saved jobs', emptySubtitle: 'Browse the job board and bookmark listings to view them here.' }) %>
<% } else { %>
  <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
    <% savedJobs.forEach(function (item) { %>
      <div class="card" style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px;">
        <h3 style="margin: 0 0 4px; font-weight: 700; font-size: 1.1rem;"><a href="/jobs/<%= item.job.id %>"><%= item.job.designation %></a></h3>
        <p style="margin: 0 0 12px; color: var(--color-text-muted); font-size: 0.88rem;"><%= item.job.companyName %> &middot; <%= item.job.location %></p>
        <div style="font-weight: 600; font-size: 0.9rem; color: var(--brand-primary); margin-bottom: 16px;"><%= item.job.salary %></div>
        <div style="display: flex; gap: 8px;">
          <a href="/jobs/<%= item.job.id %>" class="btn btn-primary btn-sm" style="flex:1; text-align:center;">View role</a>
          <form action="/applicant/saved/<%= item.job.id %>/remove" method="POST" data-confirm data-confirm-title="Remove Bookmark" data-confirm-message="Remove this job from your saved bookmarks?" data-confirm-action="Remove" data-confirm-variant="danger">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm" title="Remove bookmark">Remove</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
