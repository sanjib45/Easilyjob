<%
  // Identify if a message is a "bot/system" message (📅 interview schedule announcements)
  function isSystemMsg(content) {
    return content && (content.startsWith('📅') || content.startsWith('🗓') || content.includes('Interview Scheduled'));
  }
%>

<style>
  /* ── WhatsApp-Style Chat Room ─────────────────────── */
  .wa-chat-wrap {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 140px);
    min-height: 500px;
    background: var(--color-bg);
    border-radius: 20px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: var(--shadow-md, 0 4px 24px rgba(0,0,0,0.12));
  }

  /* Header */
  .wa-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .wa-header-avatar {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; font-weight: 800; color: #fff;
    flex-shrink: 0;
    position: relative;
  }
  .wa-online-dot {
    position: absolute; bottom: -2px; right: -2px;
    width: 12px; height: 12px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid var(--color-bg-surface);
    animation: pulse-dot 2s infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.5); }
    50% { box-shadow: 0 0 0 4px rgba(34,197,94,0); }
  }
  .wa-header-info { flex: 1; min-width: 0; }
  .wa-header-name { font-size: 1rem; font-weight: 800; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-header-sub { font-size: 0.78rem; color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-header-actions { display: flex; gap: 8px; flex-shrink: 0; }

  /* Messages Area */
  .wa-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    scroll-behavior: smooth;
  }
  .wa-messages::-webkit-scrollbar { width: 4px; }
  .wa-messages::-webkit-scrollbar-track { background: transparent; }
  .wa-messages::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

  /* Date separator */
  .wa-date-sep {
    text-align: center;
    margin: 12px 0 4px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    position: relative;
  }
  .wa-date-sep::before, .wa-date-sep::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 30%;
    height: 1px;
    background: var(--color-border);
  }
  .wa-date-sep::before { left: 5%; }
  .wa-date-sep::after { right: 5%; }

  /* Bubbles */
  .wa-bubble-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    max-width: 75%;
    animation: bubble-in 0.2s ease-out;
  }
  @keyframes bubble-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .wa-bubble-row.outgoing { align-self: flex-end; flex-direction: row-reverse; }
  .wa-bubble-row.incoming { align-self: flex-start; }

  .wa-avatar-tiny {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 800; color: #fff;
    flex-shrink: 0;
  }

  .wa-bubble {
    padding: 10px 14px;
    border-radius: 16px;
    position: relative;
    max-width: 100%;
    word-break: break-word;
    line-height: 1.5;
    font-size: 0.92rem;
  }
  .wa-bubble.outgoing {
    background: linear-gradient(135deg, #0e74d6, #0d9488);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .wa-bubble.incoming {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-bottom-left-radius: 4px;
  }
  .wa-bubble-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    justify-content: flex-end;
  }
  .wa-time {
    font-size: 0.68rem;
    opacity: 0.7;
  }
  .wa-checks {
    font-size: 0.75rem;
    color: #38bdf8;
    line-height: 1;
  }
  .wa-bubble.incoming .wa-time { color: var(--color-text-muted); }

  /* System / Bot message card */
  .wa-system-card {
    align-self: center;
    background: linear-gradient(135deg, rgba(14,116,214,0.1), rgba(13,148,136,0.1));
    border: 1px solid var(--brand-500, #0e74d6);
    border-radius: 14px;
    padding: 12px 18px;
    max-width: 85%;
    font-size: 0.84rem;
    color: var(--color-text);
    white-space: pre-line;
    text-align: center;
    animation: bubble-in 0.2s ease-out;
    margin: 8px 0;
  }
  .wa-system-card-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--brand-600, #0e74d6);
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }

  /* Typing indicator */
  .wa-typing {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .wa-dots { display: flex; gap: 3px; }
  .wa-dots span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-text-muted);
    animation: bounce-dot 1.2s infinite;
  }
  .wa-dots span:nth-child(2) { animation-delay: 0.2s; }
  .wa-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes bounce-dot {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-5px); }
  }

  /* Quick reply chips */
  .wa-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 10px 20px 4px;
    flex-shrink: 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-surface);
  }
  .wa-chip {
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .wa-chip:hover {
    background: var(--brand-600, #0e74d6);
    color: #fff;
    border-color: transparent;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(14,116,214,0.25);
  }

  /* Input bar */
  .wa-input-bar {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-surface);
    flex-shrink: 0;
  }
  .wa-input {
    flex: 1;
    resize: none;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    padding: 10px 14px;
    font-size: 0.92rem;
    font-family: inherit;
    min-height: 42px;
    max-height: 120px;
    overflow-y: auto;
    transition: border-color 0.2s;
    line-height: 1.4;
  }
  .wa-input:focus { outline: none; border-color: var(--brand-500, #0e74d6); }
  .wa-send-btn {
    width: 42px; height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0e74d6, #0d9488);
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 4px 12px rgba(13,148,136,0.35);
  }
  .wa-send-btn:hover { transform: scale(1.08); box-shadow: 0 6px 18px rgba(13,148,136,0.45); }
  .wa-send-btn:active { transform: scale(0.96); }
</style>

<div class="wa-chat-wrap">

  <!-- ── Chat Header ─────────────────────────────────── -->
  <div class="wa-header">
    <a href="/messages" class="btn btn-ghost btn-sm" style="flex-shrink:0; padding: 6px 10px;">
      <%- icon('arrow-left') %>
    </a>
    <div class="wa-header-avatar" style="background: <%= colorForName(otherUser.name) %>;">
      <%= initialsFor(otherUser.name) %>
      <span class="wa-online-dot"></span>
    </div>
    <div class="wa-header-info">
      <div class="wa-header-name"><%= otherUser.name %></div>
      <div class="wa-header-sub">
        <%= conversation.application?.job?.designation || 'Direct Chat' %> &middot; <%= conversation.application?.job?.companyName || '' %>
      </div>
    </div>
    <div class="wa-header-actions">
      <% if (conversation.application) { %>
        <a href="/applicant/applications/<%= conversation.applicationId %>" class="btn btn-secondary btn-sm" style="font-size:0.78rem; padding:6px 10px;" title="View Application">
          <%- icon('file-text') %>
        </a>
      <% } %>
    </div>
  </div>

  <!-- ── Messages Stream ────────────────────────────── -->
  <div class="wa-messages" id="waMessages">
    <% if (!messages || messages.length === 0) { %>
      <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--color-text-muted); text-align:center; gap:10px; padding: 40px 20px;">
        <%- icon('message-square', 'icon-xl') %>
        <p style="margin:0; font-size:0.9rem;">No messages yet.<br/>Say hello or share interview details.</p>
      </div>
    <% } %>

    <% messages.forEach(function(msg, idx) {
      var isOut = msg.senderId === user.id;
      var isSystem = msg.content && (msg.content.startsWith('📅') || msg.content.includes('Interview Scheduled'));
      var msgTime = msg.createdAt ? new Date(msg.createdAt).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) : '';
    %>
      <% if (isSystem) { %>
        <div class="wa-system-card">
          <div class="wa-system-card-label">📋 Interview Update</div>
          <%= msg.content %>
          <div style="font-size:0.68rem; color:var(--color-text-muted); margin-top:6px;"><%= msgTime %></div>
        </div>
      <% } else { %>
        <div class="wa-bubble-row <%= isOut ? 'outgoing' : 'incoming' %>">
          <% if (!isOut) { %>
            <div class="wa-avatar-tiny" style="background:<%= colorForName(otherUser.name) %>;">
              <%= initialsFor(otherUser.name) %>
            </div>
          <% } %>
          <div class="wa-bubble <%= isOut ? 'outgoing' : 'incoming' %>">
            <%= msg.content %>
            <div class="wa-bubble-meta">
              <span class="wa-time"><%= msgTime %></span>
              <% if (isOut) { %><span class="wa-checks">✓✓</span><% } %>
            </div>
          </div>
        </div>
      <% } %>
    <% }); %>

    <!-- Typing indicator (hidden by default) -->
    <div class="wa-typing" id="waTyping" style="display:none;">
      <div class="wa-dots">
        <span></span><span></span><span></span>
      </div>
      <span style="font-size:0.8rem;"><%= otherUser.name %> is typing</span>
    </div>
  </div>

  <!-- ── Quick Reply Chips ──────────────────────────── -->
  <div class="wa-chips" id="waChips">
    <button class="wa-chip" data-text="👋 Hello! Looking forward to the interview.">👋 Hello!</button>
    <button class="wa-chip" data-text="📅 Can we confirm the meeting time?">📅 Confirm time</button>
    <button class="wa-chip" data-text="✅ Confirmed! I'll be there on time.">✅ Confirmed</button>
    <button class="wa-chip" data-text="📄 I've shared my updated resume.">📄 Updated resume</button>
    <button class="wa-chip" data-text="🔗 The meeting link is ready.">🔗 Meeting link</button>
    <button class="wa-chip" data-text="🙏 Thank you for the opportunity!">🙏 Thank you</button>
  </div>

  <!-- ── Input Bar ──────────────────────────────────── -->
  <form class="wa-input-bar" id="waForm" action="/messages/<%= conversation.id %>/send" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="content" id="waHiddenContent" />
    <textarea
      id="waInput"
      class="wa-input"
      name="content"
      placeholder="Type a message…"
      rows="1"
      autocomplete="off"
    ></textarea>
    <button type="submit" class="wa-send-btn" title="Send">
      <%- icon('send') %>
    </button>
  </form>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function () {
  var conversationId = "<%= conversation.id %>";
  var userId = "<%= user.id %>";
  var otherName = "<%= otherUser.name %>";
  var messagesEl = document.getElementById("waMessages");
  var typingEl = document.getElementById("waTyping");
  var form = document.getElementById("waForm");
  var input = document.getElementById("waInput");
  var chips = document.querySelectorAll(".wa-chip");
  var socketReady = false;

  /* ── Helpers ── */
  function escHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function nowTime() {
    return new Date().toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
  }
  function scrollBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }
  scrollBottom();

  /* ── Socket ── */
  var socket = io({ withCredentials: true, reconnectionAttempts: 5 });

  socket.on("connect", function () {
    socketReady = true;
    socket.emit("join_room", conversationId);
  });

  socket.on("connect_error", function (err) {
    socketReady = false;
    console.warn("[Chat] Socket connection error:", err.message);
  });

  socket.on("disconnect", function () {
    socketReady = false;
  });

  socket.on("chat_error", function (data) {
    alert("Message error: " + (data.message || "Failed to send. Please try again."));
  });

  socket.on("new_message", function (msg) {
    var isOut = msg.senderId === userId;
    var content = msg.content || "";
    var isSystem = content.startsWith("📅") || content.includes("Interview Scheduled");
    var el;

    if (isSystem) {
      el = document.createElement("div");
      el.className = "wa-system-card";
      el.innerHTML =
        '<div class="wa-system-card-label">📋 Interview Update</div>' +
        escHtml(content).replace(/\n/g, "<br>") +
        '<div style="font-size:0.68rem;color:var(--color-text-muted);margin-top:6px;">' + nowTime() + "</div>";
    } else {
      el = document.createElement("div");
      el.className = "wa-bubble-row " + (isOut ? "outgoing" : "incoming");
      var avatarHtml = "";
      if (!isOut) {
        var c = ["#0e74d6","#0d9488","#6366f1","#f59e0b","#ef4444"];
        var col = c[otherName.charCodeAt(0) % c.length];
        avatarHtml = '<div class="wa-avatar-tiny" style="background:' + col + ';">' +
          otherName.slice(0, 2).toUpperCase() + "</div>";
      }
      el.innerHTML =
        avatarHtml +
        '<div class="wa-bubble ' + (isOut ? "outgoing" : "incoming") + '">' +
          escHtml(content).replace(/\n/g, "<br>") +
          '<div class="wa-bubble-meta">' +
            '<span class="wa-time">' + nowTime() + "</span>" +
            (isOut ? '<span class="wa-checks">✓✓</span>' : "") +
          "</div>" +
        "</div>";
    }

    if (typingEl && typingEl.parentNode === messagesEl) {
      messagesEl.insertBefore(el, typingEl);
    } else {
      messagesEl.appendChild(el);
    }
    scrollBottom();
    if (typingEl) typingEl.style.display = "none";
  });

  /* Typing indicators */
  socket.on("user_typing", function (data) {
    if (data.userId !== userId && typingEl) {
      typingEl.style.display = "flex";
      scrollBottom();
    }
  });
  socket.on("user_stop_typing", function (data) {
    if (data.userId !== userId && typingEl) {
      typingEl.style.display = "none";
    }
  });

  var typingTimeout;
  input.addEventListener("input", function () {
    if (socketReady) socket.emit("typing", { conversationId: conversationId });
    clearTimeout(typingTimeout);
    typingTimeout = setTimeout(function () {
      if (socketReady) socket.emit("stop_typing", { conversationId: conversationId });
    }, 1500);
    // Auto-resize textarea
    input.style.height = "auto";
    input.style.height = Math.min(input.scrollHeight, 120) + "px";
  });

  /* ── Send Message ── */
  /* Try socket first; fall back to HTTP POST if socket not connected */
  function sendText(text) {
    text = text.trim();
    if (!text) return;

    if (socketReady) {
      // Real-time path: socket handles DB write + broadcasts to room
      socket.emit("send_message", { conversationId: conversationId, content: text });
      if (socketReady) socket.emit("stop_typing", { conversationId: conversationId });
      input.value = "";
      input.style.height = "auto";
      clearTimeout(typingTimeout);
    } else {
      // Fallback: standard HTML form POST (saves to DB + redirects)
      document.getElementById("waHiddenContent").value = text;
      form.submit();
    }
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault(); // always intercept; sendText decides which path
    sendText(input.value);
    input.focus();
  });

  /* Enter to send (Shift+Enter = newline) */
  input.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendText(input.value);
    }
  });

  /* Quick-reply chips */
  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      var text = chip.getAttribute("data-text");
      if (text) sendText(text);
    });
  });
})();
</script>
