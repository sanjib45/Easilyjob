<div style="margin-bottom: 16px;">
  <a href="/recruiter/applicants" class="hint" style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-weight:500;color: var(--color-text-muted);">
    <%- icon('arrow-left') %> Back to applicants list
  </a>
</div>

<div class="page-header" style="margin-bottom: 24px;">
  <div>
    <span class="eyebrow">Candidate Review</span>
    <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0 6px;"><%= application.name %></h1>
    <p class="subtitle" style="margin: 0; color: var(--color-text-muted);">
      Applied for <strong><%= application.job.designation %></strong> at <strong><%= application.job.companyName %></strong>
    </p>
  </div>
  <div style="display:flex; gap:8px;">
    <% if (application.conversation) { %>
      <a href="/messages/<%= application.conversation.id %>" class="btn btn-primary">
        <%- icon('message-square') %> Direct Chat
      </a>
    <% } %>
    <a href="/jobs/<%= application.job.id %>/applicants/<%= application.id %>/resume" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
      <%- icon('file-text') %> Download resume
    </a>
  </div>
<% if (application.skillMatch) { %>
  <div class="panel" style="background: linear-gradient(135deg, rgba(14, 116, 214, 0.08), rgba(16, 185, 129, 0.08)); border: 1px solid var(--brand-500); border-radius: 16px; padding: 20px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 14px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.6rem;">🎯</span>
        <div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: var(--color-text);">Applicant Skill Match Score</h3>
            <span style="font-size: 0.82rem; font-weight: 800; padding: 2px 8px; border-radius: 999px; background: <%= application.skillMatch.tierColor %>22; color: <%= application.skillMatch.tierColor %>; border: 1px solid <%= application.skillMatch.tierColor %>66;">
              <%= application.skillMatch.tierLabel %>
            </span>
          </div>
          <p style="margin: 2px 0 0; font-size: 0.84rem; color: var(--color-text-muted);"><%= application.skillMatch.recommendation %></p>
        </div>
      </div>
      <% if (application.applicant && application.applicant.headline) { %>
        <span style="font-size: 0.85rem; font-weight: 600; color: var(--brand-600); background: var(--color-bg-surface); padding: 4px 10px; border-radius: 8px; border: 1px solid var(--color-border);">
          <%= application.applicant.headline %>
        </span>
      <% } %>
    </div>

    <!-- Candidate Declared Skills vs Job Skills Breakdown -->
    <div style="background: var(--color-bg-surface); border-radius: 12px; padding: 14px; border: 1px solid var(--color-border); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
      <div>
        <span style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: var(--color-success); display: flex; align-items: center; gap: 4px; margin-bottom: 6px;">
          ✓ Matched Job Skills (<%= application.skillMatch.matchedSkills.length %>)
        </span>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <% if (application.skillMatch.matchedSkills.length === 0) { %>
            <span style="font-size: 0.8rem; color: var(--color-text-muted);">None matched from candidate profile.</span>
          <% } else { %>
            <% application.skillMatch.matchedSkills.forEach(function(s) { %>
              <span style="padding: 2px 8px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; border-radius: 999px; font-size: 0.8rem; font-weight: 600;">
                ✓ <%= s %>
              </span>
            <% }) %>
          <% } %>
        </div>
      </div>
      <div>
        <span style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted); display: flex; align-items: center; gap: 4px; margin-bottom: 6px;">
          + Missing Job Skills (<%= application.skillMatch.missingSkills.length %>)
        </span>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <% if (application.skillMatch.missingSkills.length === 0) { %>
            <span style="font-size: 0.8rem; color: #10b981; font-weight: 600;">Candidate matches 100% of required skills.</span>
          <% } else { %>
            <% application.skillMatch.missingSkills.forEach(function(s) { %>
              <span style="padding: 2px 8px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); color: #f59e0b; border-radius: 999px; font-size: 0.8rem; font-weight: 600;">
                + <%= s %>
              </span>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%
  var _st = application.status;
  var _pct = 20; var _barColor = '#38bdf8';
  if (_st === 'REVIEWING')                               { _pct = 40; _barColor = '#0e74d6'; }
  if (_st === 'SHORTLISTED')                             { _pct = 60; _barColor = '#0d9488'; }
  if (_st === 'INTERVIEW_SCHEDULED' || _st === 'INTERVIEWED') { _pct = 80; _barColor = '#6366f1'; }
  if (_st === 'HIRED')                                   { _pct = 100; _barColor = '#10b981'; }
  if (_st === 'REJECTED')                                { _pct = 100; _barColor = '#ef4444'; }
%>

<div class="detail-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
  <!-- ── Left: Premium Application Details Card ── -->
  <section class="panel" style="border-radius: 18px; overflow: hidden; padding: 0;">
    <!-- Card Header -->
    <div style="background: linear-gradient(135deg, rgba(14,116,214,0.12), rgba(13,148,136,0.12)); padding: 20px 24px; display: flex; align-items: center; gap: 14px; border-bottom: 1px solid var(--color-border);">
      <div style="width: 52px; height: 52px; border-radius: 14px; background: linear-gradient(135deg, #0e74d6, #0d9488); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 900; flex-shrink: 0;">
        <%= (application.name || '?').slice(0,2).toUpperCase() %>
      </div>
      <div style="flex: 1; min-width: 0;">
        <div style="font-size: 1.05rem; font-weight: 800; color: var(--color-text);"><%= application.name %></div>
        <div style="font-size: 0.78rem; color: var(--color-text-muted);">Applied <strong><%= formatDate(application.createdAt) %></strong></div>
      </div>
      <span style="padding: 4px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 800; background: <%- _barColor %>22; color: <%- _barColor %>; border: 1px solid <%- _barColor %>66; flex-shrink: 0; white-space: nowrap;">
        <%= _st === 'REJECTED' ? '✕ Rejected' : _st === 'HIRED' ? '🎉 Hired' : application.status.replaceAll('_', ' ') %>
      </span>
    </div>

    <!-- Pipeline Progress Bar -->
    <div style="padding: 14px 24px 10px; background: var(--color-bg-surface);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted);">Pipeline Progress</span>
        <span style="font-size: 0.82rem; font-weight: 800; color: <%- _barColor %>;"><%= _pct %>%</span>
      </div>
      <div style="height: 7px; background: var(--color-border); border-radius: 999px; overflow: hidden;">
        <div style="width: <%= _pct %>%; height: 100%; background: <%- _barColor %>; border-radius: 999px; transition: width 0.6s cubic-bezier(0.4,0,0.2,1);"></div>
      </div>
      <% if (_st === 'REJECTED') { %>
        <p style="font-size: 0.74rem; color: #ef4444; font-weight: 600; margin: 6px 0 0;">⚠ Application closed — candidate not selected.</p>
      <% } else if (_st === 'HIRED') { %>
        <p style="font-size: 0.74rem; color: #10b981; font-weight: 600; margin: 6px 0 0;">🎉 Offer extended — candidate selected!</p>
      <% } %>
    </div>

    <!-- Detail Rows -->
    <div style="padding: 14px 24px 20px; display: flex; flex-direction: column; gap: 10px; background: var(--color-bg-surface);">
      <div style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 10px;">
        <span style="color: var(--brand-600, #0e74d6); flex-shrink:0; display:flex;"><%- icon('mail') %></span>
        <div style="flex:1; min-width:0;">
          <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:1px;">Email</div>
          <a href="mailto:<%= application.email %>" style="font-size:0.88rem; font-weight:600; color:var(--color-text); text-decoration:none; word-break:break-all;"><%= application.email %></a>
        </div>
        <button onclick="navigator.clipboard.writeText('<%= application.email %>').then(()=>{this.textContent='✓';setTimeout(()=>this.textContent='⎘',1500)})" style="background:none; border:1px solid var(--color-border); border-radius:6px; padding:3px 8px; cursor:pointer; font-size:0.75rem; color:var(--color-text-muted); flex-shrink:0;" title="Copy email">⎘</button>
      </div>
      <div style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 10px;">
        <span style="color: var(--brand-600, #0e74d6); flex-shrink:0; display:flex;"><%- icon('phone') %></span>
        <div style="flex:1; min-width:0;">
          <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:1px;">Phone</div>
          <a href="tel:<%= application.contact %>" style="font-size:0.88rem; font-weight:600; color:var(--color-text); text-decoration:none;"><%= application.contact %></a>
        </div>
        <button onclick="navigator.clipboard.writeText('<%= application.contact %>').then(()=>{this.textContent='✓';setTimeout(()=>this.textContent='⎘',1500)})" style="background:none; border:1px solid var(--color-border); border-radius:6px; padding:3px 8px; cursor:pointer; font-size:0.75rem; color:var(--color-text-muted); flex-shrink:0;" title="Copy phone">⎘</button>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <div style="padding:10px 12px; background:var(--color-bg); border:1px solid var(--color-border); border-radius:10px;">
          <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:2px;">Role</div>
          <div style="font-size:0.88rem; font-weight:700; color:var(--color-text); word-break:break-word;"><%= application.job.designation %></div>
        </div>
        <div style="padding:10px 12px; background:var(--color-bg); border:1px solid var(--color-border); border-radius:10px;">
          <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:2px;">Company</div>
          <div style="font-size:0.88rem; font-weight:700; color:var(--color-text);"><%= application.job.companyName %></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Right: Recruiter Review & Status ── -->
  <section class="panel">
    <div class="panel-header">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Recruiter Review & Status</h2>
      <p style="font-size: 0.82rem; color: var(--color-text-muted); margin: 2px 0 0;">Update the candidate's hiring stage and write private evaluation notes.</p>
    </div>
    <form action="/recruiter/applicants/<%= application.id %>" method="POST" style="margin-top: 16px;" data-confirm data-confirm-title="Update Candidate Stage" data-confirm-message="Are you sure you want to update <%= application.name %>'s application stage and review notes?" data-confirm-action="Update Stage" data-confirm-variant="primary">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      
      <div style="margin-bottom: 14px;">
        <label for="status" style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Application Stage</label>
        <select id="status" name="status" required style="width: 100%;">
          <% [
            ["NEW", "New"],
            ["REVIEWING", "In Review"],
            ["SHORTLISTED", "Shortlisted (notifies candidate)"],
            ["INTERVIEW_SCHEDULED", "Interview Scheduled"],
            ["INTERVIEWED", "Interviewed"],
            ["HIRED", "Hired"],
            ["REJECTED", "Rejected"]
          ].forEach(function (pair) { %>
            <option value="<%= pair[0] %>" <%= application.status === pair[0] ? "selected" : "" %>><%= pair[1] %></option>
          <% }) %>
        </select>
      </div>

      <div style="margin-bottom: 16px;">
        <label for="recruiterNote" style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">
          Private Recruiter Notes <span style="font-weight: normal; color: var(--color-text-subtle); font-size: 0.8rem;">(never visible to applicant)</span>
        </label>
        <textarea id="recruiterNote" name="recruiterNote" rows="5" maxlength="2000" placeholder="Enter notes on candidate background, screening comments, or salary expectations..." style="width: 100%;"><%= application.recruiterNote || "" %></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">
        Save stage & review
      </button>
    </form>
  </section>
</div>


<!-- Schedule new interview panel -->
<section class="panel" style="margin-bottom: 24px;">
  <div class="panel-header">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Schedule an Interview</h2>
    <p style="font-size: 0.82rem; color: var(--color-text-muted); margin: 2px 0 0;">Set up an upcoming screening or technical round for this candidate.</p>
  </div>
  <form action="/recruiter/applicants/<%= application.id %>/interviews" method="POST" style="margin-top: 16px;" data-confirm data-confirm-title="Schedule Interview" data-confirm-message="Schedule an interview session for <%= application.name %>?" data-confirm-action="Schedule Interview" data-confirm-variant="primary">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 14px;">
      <div>
        <label for="roundName" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Round Name</label>
        <select id="roundName" name="roundName" required style="width: 100%;">
          <option value="Initial Screening">Initial Screening</option>
          <option value="Technical Round">Technical Round</option>
          <option value="HR Round">HR Round</option>
          <option value="Managerial Round">Managerial Round</option>
          <option value="Final Interview">Final Interview</option>
        </select>
      </div>
      <div>
        <label for="scheduledAt" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Date and Time</label>
        <input id="scheduledAt" type="datetime-local" name="scheduledAt" required style="width: 100%;" />
      </div>
      <div>
        <label for="timezone" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Timezone</label>
        <input id="timezone" name="timezone" value="UTC" maxlength="80" required style="width: 100%;" />
      </div>
      <div>
        <label for="durationMinutes" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Duration (minutes)</label>
        <input id="durationMinutes" type="number" name="durationMinutes" value="60" min="15" max="240" required style="width: 100%;" />
      </div>
      <div>
        <label for="meetingUrl" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Meeting URL</label>
        <input id="meetingUrl" type="url" name="meetingUrl" placeholder="https://meet.google.com/..." style="width: 100%;" />
      </div>
      <div>
        <label for="location" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Physical Location (optional)</label>
        <input id="location" name="location" maxlength="200" placeholder="e.g. Headquarters Conference Room 3" style="width: 100%;" />
      </div>
    </div>
    <div style="margin-bottom: 16px;">
      <label for="candidateMessage" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 4px;">Message to Candidate</label>
      <textarea id="candidateMessage" name="candidateMessage" rows="2" maxlength="2000" placeholder="Instructions, agenda, or prerequisites for the candidate..." style="width: 100%;"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">
      <%- icon('calendar') %> Schedule interview round
    </button>
  </form>
</section>

<!-- Interview rounds list & evaluations -->
<% if (application.interviews.length > 0) { %>
  <section class="panel" style="margin-bottom: 24px;">
    <div class="panel-header">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Interview Rounds & Evaluations</h2>
      <p style="font-size: 0.82rem; color: var(--color-text-muted); margin: 2px 0 0;">Manage round outcomes, score performances, and share final decisions.</p>
    </div>

    <% application.interviews.forEach(function (interview, idx) { %>
      <div style="background: var(--color-bg); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 20px; margin-top: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 14px;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--brand-600);"><%= interview.roundName || `Round ${application.interviews.length - idx}` %></span>
              <% if (interview.evaluation) { 
                const sc = interview.evaluation.overallScore;
                const scColor = sc >= 75 ? "#10b981" : (sc >= 50 ? "#f59e0b" : "#ef4444");
              %>
                <span style="font-size: 0.72rem; font-weight: 800; background: <%= scColor %>18; color: <%= scColor %>; padding: 2px 8px; border-radius: 999px; border: 1px solid <%= scColor %>40;">
                  Score: <%= sc %>/100 &middot; <%= interview.evaluation.recommendation.replaceAll("_", " ") %>
                </span>
              <% } else { %>
                <span style="font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); background: var(--color-bg-surface); padding: 2px 8px; border-radius: 999px; border: 1px dashed var(--color-border);">
                  ⏳ Evaluation Pending
                </span>
              <% } %>
            </div>
            <h3 style="font-size: 1.05rem; font-weight: 700; margin: 2px 0 4px;">
              <%= formatDate(interview.scheduledAt) %> <span style="font-weight: normal; color: var(--color-text-muted); font-size: 0.9rem;">(<%= interview.timezone %>, <%= interview.durationMinutes %>m)</span>
            </h3>
            <% if (interview.meetingUrl) { %>
              <a href="<%= interview.meetingUrl %>" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                <%- icon('video') %> Open meeting link
              </a>
            <% } %>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="status-badge"><%= interview.status.replaceAll("_", " ") %></span>
          </div>
        </div>

        <!-- Update interview status -->
        <form action="/recruiter/interviews/<%= interview.id %>" method="POST" style="display: flex; gap: 10px; align-items: center; margin-bottom: 18px; flex-wrap: wrap;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <select name="status" aria-label="Interview status" style="font-size: 0.88rem; padding: 6px 10px;">
            <% ["SCHEDULED", "RESCHEDULED", "COMPLETED", "CANCELLED", "NO_SHOW"].forEach(function (status) { %>
              <option value="<%= status %>" <%= interview.status === status ? "selected" : "" %>><%= status.replaceAll("_", " ") %></option>
            <% }) %>
          </select>
          <input type="text" name="cancellationReason" value="<%= interview.cancellationReason || "" %>" maxlength="500" placeholder="Reason (if rescheduling or cancelling)" style="flex: 1; min-width: 180px; font-size: 0.88rem; padding: 6px 10px;" />
          <button type="submit" class="btn btn-secondary btn-sm">Update status</button>
        </form>

        <!-- Private evaluation form -->
        <div style="background: var(--color-surface); border: 1px solid var(--gray-200); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
            <h4 style="font-size: 0.92rem; font-weight: 700; margin: 0; color: var(--color-text);">
              Private Interviewer Evaluation <span style="font-weight: normal; color: var(--color-text-subtle); font-size: 0.78rem;">(recruiter-only)</span>
            </h4>
            <% if (interview.evaluation) { %>
              <span style="font-size: 0.78rem; font-weight: 700; color: #059669; display: inline-flex; align-items: center; gap: 4px; background: #ecfdf5; padding: 3px 10px; border-radius: 6px; border: 1px solid #a7f3d0;">
                <%- icon('check-circle') %> Evaluation Saved &middot; Can be updated anytime
              </span>
            <% } %>
          </div>
          <form action="/recruiter/interviews/<%= interview.id %>/evaluation" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="score-grid">
              <div class="score-field">
                <label for="eval-tech-<%= interview.id %>">Technical (0-100)</label>
                <input id="eval-tech-<%= interview.id %>" type="number" name="technicalScore" min="0" max="100" value="<%= interview.evaluation ? interview.evaluation.technicalScore : "" %>" placeholder="e.g. 85" required style="width:100%;" />
              </div>
              <div class="score-field">
                <label for="eval-comm-<%= interview.id %>">Communication (0-100)</label>
                <input id="eval-comm-<%= interview.id %>" type="number" name="communicationScore" min="0" max="100" value="<%= interview.evaluation ? interview.evaluation.communicationScore : "" %>" placeholder="e.g. 90" required style="width:100%;" />
              </div>
              <div class="score-field">
                <label for="eval-over-<%= interview.id %>">Overall Score (0-100)</label>
                <input id="eval-over-<%= interview.id %>" type="number" name="overallScore" min="0" max="100" value="<%= interview.evaluation ? interview.evaluation.overallScore : "" %>" placeholder="e.g. 88" required style="width:100%;" />
              </div>
              <div class="score-field">
                <label for="eval-rec-<%= interview.id %>">Recommendation</label>
                <select id="eval-rec-<%= interview.id %>" name="recommendation" required style="width:100%;">
                  <% [["STRONG_YES", "Strong Yes"], ["YES", "Yes"], ["MAYBE", "Maybe"], ["NO", "No"]].forEach(function (rec) { %>
                    <option value="<%= rec[0] %>" <%= interview.evaluation && interview.evaluation.recommendation === rec[0] ? "selected" : "" %>><%= rec[1] %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="feedback-grid">
              <div>
                <label for="eval-str-<%= interview.id %>" style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); display: block; margin-bottom: 4px;">Candidate Strengths</label>
                <textarea id="eval-str-<%= interview.id %>" name="strengths" rows="2" maxlength="3000" placeholder="Key strengths observed..." style="width: 100%;"><%= interview.evaluation ? interview.evaluation.strengths || "" : "" %></textarea>
              </div>
              <div>
                <label for="eval-con-<%= interview.id %>" style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); display: block; margin-bottom: 4px;">Areas of Concern</label>
                <textarea id="eval-con-<%= interview.id %>" name="concerns" rows="2" maxlength="3000" placeholder="Potential gaps or questions for next rounds..." style="width: 100%;"><%= interview.evaluation ? interview.evaluation.concerns || "" : "" %></textarea>
              </div>
            </div>

            <div style="margin-bottom: 12px;">
              <label for="eval-priv-<%= interview.id %>" style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); display: block; margin-bottom: 4px;">Private Notes</label>
              <textarea id="eval-priv-<%= interview.id %>" name="privateFeedback" rows="2" maxlength="4000" placeholder="Internal evaluation comments..." style="width: 100%;"><%= interview.evaluation ? interview.evaluation.privateFeedback || "" : "" %></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-sm">
              <%= interview.evaluation ? "Update evaluation score" : "Save private evaluation" %>
            </button>
          </form>
        </div>

        <!-- Shared Result Status or CTA -->
        <% if (interview.result) { %>
          <div class="share-result-box">
            <div class="share-result-title">
              <%- icon('check-circle') %> Interview Result Shared with Candidate
            </div>
            <div class="share-result-desc">
              Decision: <strong><%= interview.result.outcome %></strong> · Shared on <%= formatDate(interview.result.sharedAt) %>
            </div>
            <div style="background: var(--color-surface); border-radius: var(--radius-sm); padding: 10px 14px; font-size: 0.88rem; color: var(--color-text);">
              "<%= interview.result.summary %>"
            </div>
          </div>
        <% } else if (interview.status === "COMPLETED") { %>
          <div class="share-result-box" style="background: var(--brand-50); border-color: var(--brand-200);">
            <div class="share-result-title">
              <%- icon('send') %> Ready to Share Result
            </div>
            <div class="share-result-desc">
              This interview is marked Completed. You can send a public-safe outcome and summary email to the candidate.
            </div>
            <a href="/recruiter/interviews/<%= interview.id %>/share-result" class="btn btn-primary btn-sm">
              Share result with candidate
            </a>
          </div>
        <% } %>
      </div>
    <% }) %>
  </section>
<% } %>

<!-- Status History Timeline -->
<section class="panel">
  <div class="panel-header">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Status Transition Timeline</h2>
    <p style="font-size: 0.82rem; color: var(--color-text-muted); margin: 2px 0 0;">Audit trail of all status updates and transitions for this application.</p>
  </div>
  <% if (application.statusHistory.length === 0) { %>
    <p class="hint" style="margin-top: 14px;">No status changes recorded yet.</p>
  <% } else { %>
    <div class="timeline">
      <% application.statusHistory.forEach(function (entry) { %>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-header">
            <span class="timeline-status">
              <% if (entry.fromStatus) { %>
                <%= entry.fromStatus.replaceAll("_", " ") %> → <strong><%= entry.toStatus.replaceAll("_", " ") %></strong>
              <% } else { %>
                Application Created (<%= entry.toStatus %>)
              <% } %>
            </span>
            <span class="timeline-date"><%= formatDate(entry.createdAt) %></span>
          </div>
          <% if (entry.reason) { %>
            <div class="timeline-reason"><%= entry.reason %></div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
