# Copy this file to .env and fill in real values. Never commit .env to version control.

# Server
NODE_ENV=development
PORT=3000

# Session
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Cookies are marked "secure" automatically when NODE_ENV=production (requires HTTPS).
# Set to "true" to force secure cookies even outside production (e.g. behind a TLS proxy).
FORCE_SECURE_COOKIES=false

# Outgoing email (used to notify applicants). Leave blank to disable email sending.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Job Portal <no-reply@example.com>"

# Uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting (login/register brute-force protection)
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
