model Conversation {
  id            String   @id @default(cuid()) @map("_id")
  applicationId String
  recruiterId   String
  applicantId   String
  lastMessage   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recruiter   User        @relation("RecruiterConversations", fields: [recruiterId], references: [id], onDelete: Cascade)
  applicant   User        @relation("ApplicantConversations", fields: [applicantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([applicationId])
  @@index([recruiterId, lastMessageAt])
  @@index([applicantId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid()) @map("_id")
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
