generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String
  email         String    @unique
  passwordHash  String
  /// APPLICANT | RECRUITER
  role          String
  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique
  verifyExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs          Job[]
  applications  Application[]
  refreshTokens RefreshToken[]
  interviews    Interview[]
}

model Job {
  id                   String    @id @default(cuid()) @map("_id")
  category             String
  designation          String
  location             String
  companyName          String
  salary               String
  openings             Int
  skills               String
  applyBy              DateTime
  status               String    @default("OPEN")
  closedAt             DateTime?
  publishedAt          DateTime?
  applicationsAccepted Int       @default(0)
  recruiterId          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  recruiter    User          @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications Application[]
  interviews   Interview[]

  @@index([recruiterId])
  @@index([location])
  @@index([category])
  @@index([applyBy])
  @@index([status, applyBy, createdAt])
  @@index([recruiterId, status, createdAt])
}

model Application {
  id          String   @id @default(cuid()) @map("_id")
  jobId       String
  applicantId String?
  name        String
  email       String
  contact     String
  resumePath  String
  status      String    @default("NEW")
  recruiterNote String?
  statusUpdatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User? @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  statusHistory ApplicationStatusHistory[]
  interviews Interview[]

  @@unique([jobId, email])
  @@index([applicantId])
  @@index([jobId, createdAt])
  @@index([applicantId, createdAt])
}

model ApplicationStatusHistory {
  id            String   @id @default(cuid()) @map("_id")
  applicationId String
  actorId       String
  fromStatus    String?
  toStatus      String
  reason        String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
}

model Interview {
  id                 String   @id @default(cuid()) @map("_id")
  applicationId      String
  jobId              String
  recruiterId        String
  scheduledAt        DateTime
  timezone           String
  durationMinutes    Int      @default(60)
  meetingUrl         String?
  location           String?
  candidateMessage   String?
  status             String   @default("SCHEDULED")
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiter   User        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  evaluation  InterviewEvaluation?

  @@index([recruiterId, scheduledAt, status])
  @@index([applicationId, scheduledAt])
  @@index([jobId, scheduledAt])
}

model InterviewEvaluation {
  id                  String   @id @default(cuid()) @map("_id")
  interviewId         String   @unique
  applicationId       String
  recruiterId         String
  technicalScore      Int
  communicationScore  Int
  overallScore        Int
  recommendation      String
  strengths           String?
  concerns            String?
  privateFeedback     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([recruiterId, createdAt])
  @@index([applicationId, createdAt])
}

model EmailOutbox {
  idempotencyKey String   @id @map("_id")
  toEmail        String
  type           String
  payload        String
  status         String   @default("QUEUED")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([toEmail, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid()) @map("_id")
  toEmail   String
  subject   String
  type      String
  status    String
  error     String?
  createdAt DateTime @default(now())
}
