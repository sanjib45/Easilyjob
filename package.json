{
  "name": "easily-job-portal",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "node scripts/setup-mongodb.mjs",
    "db:import:mongodb": "node scripts/migrate-sqlite-to-mongodb.mjs",
    "db:import:mongodb:replace": "cross-env MONGO_IMPORT_REPLACE=true node scripts/migrate-sqlite-to-mongodb.mjs",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node scripts/smoke-test.mjs",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "job-portal",
    "express",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "description": "Job portal with Prisma, JWT access/refresh tokens, and email verification.",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cross-env": "^7.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.13.1",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
